import { Palette } from "std-widgets.slint";

// rounded/bordered container, used for rule cards and the default-opener card
export component Card inherits Rectangle {
    background: Palette.alternate-background;
    border-color: Palette.border;
    border-width: 1px;
    border-radius: 10px;
}

export enum ThemeChoice { auto, light, dark }
export enum TextSizeChoice { normal, large, larger }

// single source of truth for the browser row height - main_window.slint's BrowserRow height
// and its drag-drop index math have to agree on this value
export global Layout {
    out property <relative-font-size> browser-row-height: (32 / 12) * 1rem;
}

export struct DirEntry {
    label: string,
    path: string,
}

// label/path two-column list - used by both about_window.slint and settings_window.slint's
// AdvancedTab, which show the same Config/Cache/Logs/Resources directories at different sizes
export component DirectoriesList inherits HorizontalLayout {
    in property <[DirEntry]> directories;
    in property <length> entry-font-size: 11px;
    in property <brush> entry-color: Palette.foreground;

    spacing: 6px;
    VerticalLayout {
        alignment: start;
        for d in root.directories: Text {
            text: d.label;
            font-size: root.entry-font-size;
            horizontal-alignment: right;
            color: root.entry-color;
        }
    }
    VerticalLayout {
        alignment: start;
        for d in root.directories: TextInput {
            text: d.path;
            font-size: root.entry-font-size;
            color: root.entry-color;
            read-only: true;
            // like macOS: a light blue fill, and the selected text goes to full black (white in
            // the dark theme), whatever the text color was. The dark fill is an approximation
            selection-background-color: Palette.color-scheme == ColorScheme.dark ? #3e6190 : #bbd6fc;
            selection-foreground-color: Palette.color-scheme == ColorScheme.dark ? #ffffff : #000000;
        }
    }
}
