import {
    LineEdit,
    Switch,
    Button,
    CheckBox,
    ScrollView,
    Palette,
    ComboBox,
    Slider,
} from "std-widgets.slint";
import { Card, DirEntry, DirectoriesList, TextSizeChoice, ThemeChoice } from "common.slint";
import { BrowserItem, RestorableProfile } from "main_window.slint";

export enum SettingsTab { general, appearance, rules, advanced }

export struct SettingsRule {
    index: int, // -1 means "default opener" row
    url-pattern: string,
    opener-id: string,
    opener-label: string,
    // index into profile-picker-options / (offset by one) browsers: 0 is the synthetic "List of
    // Apps" entry, N+1 is browsers[N]. Rust computes this alongside opener-label so ProfilePicker
    // can drive the ComboBox by position instead of matching on opener-label's text.
    opener-index: int,
    incognito: bool,
    show-incognito: bool,
}

component ProfilePicker inherits HorizontalLayout {
    in property <[BrowserItem]> browsers;
    // "List of Apps" followed by one entry per browser, same order as browsers - shared across
    // every row's ComboBox since the choices themselves don't vary per rule, only the selection.
    in property <[string]> profile-picker-options;
    in property <SettingsRule> rule;
    spacing: 6px;
    // without this, the default stretch alignment redistributes space between the ComboBox and
    // the incognito checkbox below whenever the checkbox appears/disappears (depends on which
    // browser is picked), which shifts the dropdown sideways.
    // start just packs everything to its natural size instead, so the dropdown stays put either
    // way
    alignment: start;

    callback profile-changed(string);
    callback incognito-changed(bool);

    Text {
        text: rule.opener-id == "" ? "Show" : "Open in";
        font-size: 13px;
        vertical-alignment: center;
    }

    picker := ComboBox {
        width: 220px;
        model: root.profile-picker-options;
        current-index: root.rule.opener-index;
        selected(value) => {
            // by position, not by matching value against a browser's name - two profiles could
            // share a display name, and the model/browsers arrays are built in lockstep anyway
            root.profile-changed(self.current-index == 0 ? "" : root.browsers[self.current-index - 1].unique-id);
        }
    }

    // CheckBox's own gap between box and label is fixed, so the label is a separate Text
    // (clickable, like the CheckBox's own) and the CheckBox is cut to just the box
    if rule.show-incognito: HorizontalLayout {
        spacing: 4px;
        CheckBox {
            width: 16px;
            checked: root.rule.incognito;
            toggled => { root.incognito-changed(self.checked); }
        }

        TouchArea {
            clicked => { root.incognito-changed(!root.rule.incognito); }
            Text {
                text: "In Incognito";
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
}

component SectionLabel inherits VerticalLayout {
    in property <string> text;
    // the tabs only space their children 8px apart, this separates a section from the group above
    padding-top: 12px;
    padding-left: 14px;
    Text {
        text: root.text;
        font-size: 13px;
        font-weight: 700;
        color: Palette.foreground;
    }
}

// rounded container for a list of SettingRows
component SettingsGroup inherits Card {
    clip: true;
    border-width: 0px;
    border-radius: 12px;
    VerticalLayout {
        spacing: 0px;
        @children
    }
}

// title (and optional description) on the left, the control (@children) on the right.
// `divider` draws a hairline above the row - off for the first row of a group
component SettingRow inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    in property <bool> divider: true;
    // the control fills the row's full height and touches its right edge (the card clips the corners)
    in property <bool> flush-right: false;
    // for a control taller than the title (the theme tiles): the title goes to the top left
    // instead of being centered next to it
    in property <bool> title-at-top: false;
    spacing: 0px;

    if root.divider: HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Rectangle {
            height: 1px;
            background: Palette.foreground.transparentize(0.94);
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: root.flush-right ? 0px : 14px;
        padding-top: root.flush-right ? 0px : 10px;
        padding-bottom: root.flush-right ? 0px : 10px;
        spacing: 12px;
        min-height: 40px;
        // center instead of the default stretch, so a fixed-height control (Switch, Button)
        // is vertically centered next to the title
        cross-axis-alignment: center;

        VerticalLayout {
            spacing: 2px;
            max-width: 430px;
            cross-axis-self-alignment: root.title-at-top ? CrossAxisAlignment.start : CrossAxisAlignment.auto;
            // measured against System Settings at 2x: the title comes out narrower here than in
            // macOS (the same font, but macOS tracks it), so it gets a little letter spacing, and the
            // description matches macOS at 12px without any
            Text {
                text: root.title;
                font-size: 13px;
                letter-spacing: 0.25px;
                color: Palette.foreground;
            }

            if root.description != "": Text {
                text: root.description;
                font-size: 12px;
                color: Palette.foreground.transparentize(0.4);
                wrap: word-wrap;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        @children
    }
}

// selector with one segment per option
component SegmentedControl inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    callback selected(int);

    width: root.options.length * 88px;
    height: 28px;
    background: Palette.foreground.transparentize(0.94);
    // a large radius is clamped to half the height, so the control and the selected segment are pills
    border-radius: 100px;

    HorizontalLayout {
        padding: 2px;
        for option[i] in root.options: Rectangle {
            border-radius: 100px;
            background: root.current == i ? Palette.accent-background : transparent;
            Text {
                text: option;
                font-size: 12px;
                color: root.current == i ? Palette.accent-foreground : Palette.foreground;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => { root.selected(i); }
            }
        }
    }
}

// miniature desktop with the main popup on it (no title bar or window controls, just the list of
// apps with their hotkeys), like System Settings' appearance picker
component ThemePreview inherits Rectangle {
    in property <bool> dark;
    background: root.dark
        ? @linear-gradient(135deg, #1b1f6b 0%, #3a2d9c 100%)
        : @linear-gradient(135deg, #8fb8f0 0%, #5a8fe0 100%);

    // the popup's own light/dark colors, as in AppPalette (which follows the real theme, so it
    // can't be used for a preview of the other one)
    property <color> label: root.dark ? #ffffff : #000000;

    Rectangle {
        width: 38px;
        height: 38px;
        border-radius: 4px;
        background: root.dark ? #262626 : #d9d9d9;
        VerticalLayout {
            padding: 3px;
            spacing: 1px;
            for c[i] in [#4285f4, #ff9f0a, #34c759]: Rectangle {
                height: 10px;
                border-radius: 2.5px;
                background: i == 0 ? #ffffff40 : transparent;
                HorizontalLayout {
                    padding-left: 2px;
                    padding-right: 2px;
                    spacing: 2px;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        y: 2px;
                        border-radius: 3px;
                        background: c;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1.5px;
                        Rectangle {
                            width: 12px;
                            height: 2.4px;
                            border-radius: 1.2px;
                            background: root.label;
                        }

                        Rectangle {
                            width: 8px;
                            height: 1.8px;
                            border-radius: 0.9px;
                            background: root.label.transparentize(0.55);
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 5px;
                        height: 5px;
                        y: 2.5px;
                        border-radius: 1.5px;
                        background: root.dark ? #ffffff26 : #0000001f;
                    }
                }
            }
        }
    }
}

// kind: 0 follows the system (half light, half dark), 1 light, 2 dark
component ThemeTile inherits VerticalLayout {
    in property <string> label;
    in property <int> kind;
    in property <bool> selected;
    callback clicked;
    width: 76px;
    spacing: 4px;

    Rectangle {
        height: 52px;
        border-radius: 9px;
        border-width: 2px;
        border-color: root.selected ? Palette.accent-background : transparent;
        Rectangle {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            border-radius: 6px;
            clip: true;
            if root.kind != 0: ThemePreview {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                dark: root.kind == 2;
            }

            // System: the left half of the light preview next to the right half of the dark one
            if root.kind == 0: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width / 2;
                height: parent.height;
                clip: true;
                ThemePreview {
                    x: 0px;
                    y: 0px;
                    width: parent.width * 2;
                    height: parent.height;
                    dark: false;
                }
            }

            if root.kind == 0: Rectangle {
                x: parent.width / 2;
                y: 0px;
                width: parent.width / 2;
                height: parent.height;
                clip: true;
                ThemePreview {
                    x: -parent.width;
                    y: 0px;
                    width: parent.width * 2;
                    height: parent.height;
                    dark: true;
                }
            }
        }

        TouchArea {
            clicked => { root.clicked(); }
        }
    }

    Text {
        text: root.label;
        font-size: 12px;
        horizontal-alignment: center;
        color: root.selected ? Palette.foreground : Palette.foreground.transparentize(0.4);
    }
}

component GeneralTab inherits VerticalLayout {
    in property <bool> quit-on-lost-focus;
    in property <bool> show-quit-on-lost-focus;
    in property <bool> unwrap-urls;
    in property <[RestorableProfile]> restorable-app-profiles;

    callback quit-on-lost-focus-changed(bool);
    callback unwrap-urls-changed(bool);
    callback restore-profile(string);

    padding: 20px;
    alignment: start;
    spacing: 8px;

    SectionLabel {
        text: "Behavior";
    }

    SettingsGroup {
        if show-quit-on-lost-focus: SettingRow {
            title: "Quit when focus is lost";
            divider: false;
            Switch {
                checked: root.quit-on-lost-focus;
                toggled => { root.quit-on-lost-focus-changed(self.checked); }
            }
        }

        SettingRow {
            title: "Unwrap URLs";
            divider: root.show-quit-on-lost-focus;
            Switch {
                checked: root.unwrap-urls;
                toggled => { root.unwrap-urls-changed(self.checked); }
            }
        }
    }

    SectionLabel {
        text: "Applications and Profiles";
    }

    SettingsGroup {
        SettingRow {
            title: "Hidden applications and profiles";
            description: "Hide and re-order applications and profiles in the main window, "
                + "by drag-and-drop or right-click.";
            divider: false;

            ram := ContextMenuArea {
                // ContextMenuArea doesn't forward the Button's size to the layout it sits in, so
                // it needs the Button's size spelled out here
                width: 130px;
                height: 26px;
                Menu {
                    if root.restorable-app-profiles.length == 0: MenuItem {
                        title: "No hidden apps or profiles";
                        enabled: false;
                    }
                    for p in root.restorable-app-profiles: MenuItem {
                        title: p.full-name;
                        activated => { root.restore-profile(p.unique-id); }
                    }
                }

                Button {
                    x: 0px;
                    width: 130px;
                    height: 26px;
                    text: "Restore App...";
                    // Button doesn't expose a mouse-x/mouse-y like TouchArea does, so just anchor
                    // the menu under the button's bottom-left corner instead of the click position
                    clicked => { ram.show({ x: 0px, y: self.height }); }
                }
            }
        }
    }
}

component AppearanceTab inherits VerticalLayout {
    in property <ThemeChoice> theme;
    in property <bool> show-hotkeys;
    in property <TextSizeChoice> text-size;
    in property <int> max-visible-browsers;
    in property <int> min-visible-browsers;
    in property <int> max-visible-browsers-limit;

    callback theme-changed(ThemeChoice);
    callback show-hotkeys-changed(bool);
    callback text-size-changed(TextSizeChoice);
    callback max-visible-browsers-changed(int);

    padding: 20px;
    alignment: start;
    spacing: 8px;

    SectionLabel {
        text: "Theme";
    }

    SettingsGroup {
        SettingRow {
            title: "Appearance";
            divider: false;
            title-at-top: true;
            // Rust re-echoes root.theme right back after every change (see save_and_refresh in
            // settings_window.rs), so the selected tile follows `theme` one-way
            HorizontalLayout {
                spacing: 12px;
                padding-top: 4px;
                for opt[i] in [
                    { label: "System", choice: ThemeChoice.auto },
                    { label: "Light", choice: ThemeChoice.light },
                    { label: "Dark", choice: ThemeChoice.dark },
                ]: ThemeTile {
                    label: opt.label;
                    kind: i;
                    selected: root.theme == opt.choice;
                    clicked => { root.theme-changed(opt.choice); }
                }
            }
        }
    }

    SectionLabel {
        text: "Main Window";
    }

    SettingsGroup {
        SettingRow {
            title: "Text size";
            divider: false;
            SegmentedControl {
                options: ["Normal", "Large", "Larger"];
                current: root.text-size == TextSizeChoice.normal ? 0
                    : root.text-size == TextSizeChoice.large ? 1 : 2;
                selected(i) => {
                    root.text-size-changed(i == 0 ? TextSizeChoice.normal
                        : i == 1 ? TextSizeChoice.large : TextSizeChoice.larger);
                }
            }
        }

        SettingRow {
            title: "Visible browsers";
            description: "How many are shown before the list scrolls";
            HorizontalLayout {
                spacing: 10px;
                Slider {
                    width: 140px;
                    minimum: root.min-visible-browsers;
                    maximum: root.max-visible-browsers-limit;
                    step: 1;
                    value: root.max-visible-browsers;
                    changed(v) => {
                        // dragging is continuous: snap to whole numbers, and only save when
                        // the number actually changes
                        self.value = Math.round(v);
                        if (Math.round(v) != root.max-visible-browsers) {
                            root.max-visible-browsers-changed(Math.round(v));
                        }
                    }
                }

                Text {
                    text: root.max-visible-browsers;
                    width: 20px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
            }
        }

        SettingRow {
            title: "Show hotkeys";
            Switch {
                checked: root.show-hotkeys;
                toggled => { root.show-hotkeys-changed(self.checked); }
            }
        }
    }
}

// not a std-widgets Button, which has a hover effect (macOS has none) - only pressed is darker
component AddRuleButton inherits TouchArea {
    in property <string> text: "Add Rule";
    width: 80px;
    height: 24px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { self.clicked(); }
    Rectangle {
        border-radius: 5.5px;
        background: Palette.foreground.transparentize(root.pressed ? 0.85 : 0.92);
        Text {
            text: root.text;
            font-size: 13px;
            color: Palette.foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component RuleCard inherits Card {
    in property <SettingsRule> rule;
    // the rule that the "Test a URL" field matched
    in property <bool> highlighted;
    border-color: Palette.accent-background;
    border-width: root.highlighted ? 2px : 0px;
    border-radius: 12px;
    in property <[BrowserItem]> browsers;
    in property <[string]> profile-picker-options;
    callback url-changed(int, string);
    callback profile-changed(int, string);
    callback incognito-changed(int, bool);
    callback remove(int);

    HorizontalLayout {
        padding: 14px;
        spacing: 10px;

        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "If URL matches";
                    font-size: 13px;
                    vertical-alignment: center;
                }

                LineEdit {
                    width: 300px;
                    text: rule.url-pattern;
                    placeholder-text: "https://";
                    edited(t) => { root.url-changed(rule.index, t); }
                }
            }

            ProfilePicker {
                rule: rule;
                browsers: browsers;
                profile-picker-options: profile-picker-options;
                profile-changed(id) => { root.profile-changed(rule.index, id); }
                incognito-changed(v) => { root.incognito-changed(rule.index, v); }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        remove-ta := TouchArea {
            width: 26px;
            height: 26px;
            clicked => { root.remove(rule.index); }
            // a trash can, drawn as a Path: it can't be mistaken for the "x" that clears a text field
            // no hover effect, like macOS - only the stroke goes full black while pressed
            Path {
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: "M 1.5 3 L 10.5 3 M 4.5 3 L 4.5 1.5 L 7.5 1.5 L 7.5 3 "
                    + "M 2.5 3 L 3.2 10.5 L 8.8 10.5 L 9.5 3 M 5 5 L 5 8.5 M 7 5 L 7 8.5";
                stroke: remove-ta.pressed ? Palette.foreground : Palette.foreground.transparentize(0.3);
                stroke-width: 1.2px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
    }
}

component RulesTab inherits VerticalLayout {
    in property <[SettingsRule]> rules;
    in property <SettingsRule> default-rule;
    in property <[BrowserItem]> browsers;
    in property <[string]> profile-picker-options;
    in property <[BrowserItem]> default-browsers;
    in property <[string]> default-profile-picker-options;

    callback add-rule();
    callback remove-rule(int);
    callback url-changed(int, string);
    callback profile-changed(int, string);
    callback incognito-changed(int, bool);
    callback test-url-edited();

    in-out property <string> test-url-text;
    in property <string> test-url-result;
    in property <int> test-url-match-index: -2;

    // set by "Add Rule": the next time the list's content height changes (the new card being laid
    // out), scroll to the very bottom so the hint text below the cards stays visible too
    property <bool> scroll-to-new-rule: false;

    // no alignment here on purpose (leaving it at the default stretch) - it used to be set to
    // start, which pinned every child, including the ScrollView below, to its minimum/preferred
    // size instead of letting stretch hand out the leftover space, so the rule list never
    // actually grew to fill the tab.
    // same bug as the hotkey badges in main_window.slint's BrowserRow, just a different symptom.
    spacing: 0px;

    // full-width header bar (edge to edge, square corners) holding the URL tester, so it stays
    // visible while the rules scroll
    VerticalLayout {
        spacing: 0px;
        vertical-stretch: 0;
        Rectangle {
            background: Palette.alternate-background;
            // the height comes from the layout below, not stretch - left to stretch this would
            // grow to fill the whole page
            vertical-stretch: 0;
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Test a URL";
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    LineEdit {
                        text <=> root.test-url-text;
                        placeholder-text: "Paste a link to see which rule applies";
                        edited(t) => { root.test-url-edited(); }
                    }
                }

                if root.test-url-result != "": Text {
                    text: root.test-url-result;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.foreground.transparentize(0.94);
        }
    }

    ScrollView {
        vertical-stretch: 1;
        changed content-height => {
            if root.scroll-to-new-rule {
                root.scroll-to-new-rule = false;
                self.content-y = min(0px, self.visible-height - self.content-height);
            }
        }
        VerticalLayout {
            alignment: start;
            spacing: 8px;
            padding: 20px;

            SectionLabel {
                text: "Rules";
            }

            // the footer's button is easy to miss when the list is empty
            if root.rules.length == 0: HorizontalLayout {
                padding-left: 14px;
                alignment: start;
                AddRuleButton {
                    text: "Add Your First Rule";
                    width: 140px;
                    clicked => { root.add-rule(); }
                }
            }

            for rule in root.rules: RuleCard {
                rule: rule;
                highlighted: rule.index == root.test-url-match-index;
                browsers: root.browsers;
                profile-picker-options: root.profile-picker-options;
                url-changed(idx, t) => { root.url-changed(idx, t); }
                profile-changed(idx, id) => { root.profile-changed(idx, id); }
                incognito-changed(idx, v) => { root.incognito-changed(idx, v); }
                remove(idx) => { root.remove-rule(idx); }
            }

            VerticalLayout {
                padding-left: 14px;
                padding-top: 4px;
                spacing: 6px;
                Text {
                    text: "URL matching examples:\n"
                        + " • github.com/Browsers-software/** starts with \"github.com/Browsers-software/\"\n"
                        + " • github.com/**/end starts with \"github.com/\" and ends with \"/end\"\n"
                        + " • github.com/*/end starts with \"github.com/\" and ends with \"/end\" "
                        + "but can have\n   only up to one path item in between";
                    font-size: 11px;
                    color: Palette.foreground.transparentize(0.4);
                    wrap: word-wrap;
                }

                StyledText {
                    // a markdown literal can't be split over lines (or concatenated), so the visible
                    // link text is kept short instead
                    text: @markdown("See the [Rules wiki](https://github.com/Browsers-software/browsers/wiki/Rules) for all the details.");
                    default-font-size: 11px;
                    default-color: Palette.foreground.transparentize(0.4);
                    link-color: Palette.accent-background;
                    link-clicked(link) => { Platform.open-url(link); }
                }
            }
        }
    }
    // full-width footer bar, like the header: the default rule and "Add Rule" stay visible too
    VerticalLayout {
        spacing: 0px;
        vertical-stretch: 0;
        Rectangle {
            height: 1px;
            background: Palette.foreground.transparentize(0.94);
        }

        Rectangle {
            background: Palette.alternate-background;
            vertical-stretch: 0;
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 12px;
                padding-bottom: 12px;
                HorizontalLayout {
                    VerticalLayout {
                        alignment: start;
                        spacing: 6px;
                        Text {
                            text: "If no rules match";
                            font-size: 13px;
                            font-weight: 600;
                        }

                        Rectangle {
                            // the outline of the default opener being the one that decides the tested
                            // URL, drawn outside the picker so the picker stays in line with the title
                            Rectangle {
                                x: -6px;
                                y: -4px;
                                width: parent.width + 12px;
                                height: parent.height + 8px;
                                border-radius: 8px;
                                border-width: 2px;
                                border-color: root.test-url-match-index == root.default-rule.index
                                    ? Palette.accent-background : transparent;
                            }

                            ProfilePicker {
                                rule: root.default-rule;
                                browsers: root.default-browsers;
                                profile-picker-options: root.default-profile-picker-options;
                                profile-changed(id) => { root.profile-changed(-1, id); }
                                incognito-changed(v) => { root.incognito-changed(-1, v); }
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    // the padding lines the button up with the dropdown's vertical center
                    VerticalLayout {
                        alignment: end;
                        padding-bottom: 3px;
                        AddRuleButton {
                            clicked => {
                                root.scroll-to-new-rule = true;
                                root.add-rule();
                            }
                        }
                    }
                }
            }
        }
    }
}

component AdvancedTab inherits VerticalLayout {
    in property <[DirEntry]> directories;
    in property <bool> is-default-browser;
    callback set-default();
    callback refresh();

    padding: 20px;
    alignment: start;
    spacing: 8px;

    SettingsGroup {
        SettingRow {
            title: "Default browser";
            description: root.is-default-browser ? "Browsers is already your default browser."
                : "Browsers is not your default browser.";
            divider: false;
            // always clickable, so it can be set again
            Button {
                text: root.is-default-browser ? "Set as Default Again" : "Set Browsers as a Default Browser";
                clicked => { root.set-default(); }
            }
        }

        SettingRow {
            title: "Installed applications";
            Button {
                text: "Rescan Installed Apps";
                clicked => { root.refresh(); }
            }
        }
    }

    SectionLabel {
        text: "Directories";
    }

    SettingsGroup {
        HorizontalLayout {
            padding: 14px;
            DirectoriesList {
                directories: root.directories;
            }
        }
    }
}

export component SettingsWindow inherits Window {
    // like System Settings, the title bar names the current page
    title: root.current-tab == SettingsTab.general ? "General"
        : root.current-tab == SettingsTab.appearance ? "Appearance"
        : root.current-tab == SettingsTab.rules ? "Rules"
        : "System";
    // same level as the main popup, otherwise this renders behind it - NSWindowLevel stacking is
    // absolute, not affected by which window is active
    always-on-top: true;
    // tried preferred-width/preferred-height here first, but they don't actually take effect -
    // the shown size just ends up being whatever the currently-visible tab's content computes to
    // (General's, since it's the default tab), so Rules' wider content (a 300px LineEdit plus its
    // row) never got the room it needed.
    // width/height are a hard size Slint always honors, so using those instead - can't combine
    // them with min-width/min-height though (compile error), so those had to go.
    width: 750px;
    height: 500px;

    in-out property <SettingsTab> current-tab: SettingsTab.general;

    in property <bool> show-hotkeys;
    in property <bool> quit-on-lost-focus;
    in property <bool> show-quit-on-lost-focus;
    in property <bool> unwrap-urls;
    in property <[RestorableProfile]> restorable-app-profiles;

    in property <ThemeChoice> theme;
    in property <TextSizeChoice> text-size;
    in property <int> max-visible-browsers;
    in property <int> min-visible-browsers;
    in property <int> max-visible-browsers-limit;

    in property <[SettingsRule]> rules;
    in property <SettingsRule> default-rule;
    in property <[BrowserItem]> browsers;
    in property <[string]> profile-picker-options;
    // "If no rules match" has its own, shorter list - see default_opener_choices in Rust
    in property <[BrowserItem]> default-browsers;
    in property <[string]> default-profile-picker-options;

    in property <[DirEntry]> directories;
    in property <bool> is-default-browser;

    // the "Test a URL" field of the Rules tab: what was typed, and the result Rust worked out
    in-out property <string> test-url-text;
    in property <string> test-url-result;
    in property <int> test-url-match-index: -2;

    callback test-url-edited();
    callback show-hotkeys-changed(bool);
    callback quit-on-lost-focus-changed(bool);
    callback unwrap-urls-changed(bool);
    callback restore-profile(string);
    callback theme-changed(ThemeChoice);
    callback text-size-changed(TextSizeChoice);
    callback max-visible-browsers-changed(int);
    callback add-rule();
    callback remove-rule(int);
    callback rule-url-changed(int, string);
    callback rule-profile-changed(int, string);
    callback rule-incognito-changed(int, bool);
    callback set-default-browser();
    callback refresh();

    Rectangle {
        background: Palette.background;

        HorizontalLayout {
            sidebar := Rectangle {
                width: 180px;
                background: Palette.alternate-background;

                VerticalLayout {
                    padding: 10px;
                    padding-top: 14px;
                    spacing: 2px;
                    alignment: start;

                    for t in [
                        {
                            tab: SettingsTab.general,
                            label: "General",
                            icon: "M 6.57 3.00 L 6.89 1.39 L 9.11 1.39 L 9.43 3.00 L 10.52 3.45 L 11.89 2.55"
                                + " L 13.45 4.11 L 12.55 5.48 L 13.00 6.57 L 14.61 6.89 L 14.61 9.11 L 13.00 9.43"
                                + " L 12.55 10.52 L 13.45 11.89 L 11.89 13.45 L 10.52 12.55 L 9.43 13.00"
                                + " L 9.11 14.61 L 6.89 14.61 L 6.57 13.00 L 5.48 12.55 L 4.11 13.45 L 2.55 11.89"
                                + " L 3.45 10.52 L 3.00 9.43 L 1.39 9.11 L 1.39 6.89 L 3.00 6.57 L 3.45 5.48"
                                + " L 2.55 4.11 L 4.11 2.55"
                                + " L 5.48 3.45 Z M 8 5.9 A 2.1 2.1 0 1 1 8 10.1 A 2.1 2.1 0 1 1 8 5.9 Z",
                            fill-a: "",
                            fill-b: "",
                        },
                        {
                            tab: SettingsTab.appearance,
                            label: "Appearance",
                            // a ring, its right half filled with the small inner circle cut out
                            // of it, and the inner circle's left half filled
                            icon: "M 8 1.5 A 6.5 6.5 0 1 0 8 14.5 A 6.5 6.5 0 1 0 8 1.5 Z",
                            fill-a: "M 8 1.5 A 6.5 6.5 0 0 1 8 14.5 Z M 8 5.4 A 2.6 2.6 0 0 1 8 10.6 Z",
                            fill-b: "M 8 5.4 A 2.6 2.6 0 0 0 8 10.6 Z",
                        },
                        {
                            tab: SettingsTab.rules,
                            label: "Rules",
                            // a list inside a rounded rectangle
                            icon: "M 4 2 L 12 2 A 2 2 0 0 1 14 4 L 14 12 A 2 2 0 0 1 12 14 "
                                + "L 4 14 A 2 2 0 0 1 2 12 L 2 4 A 2 2 0 0 1 4 2 Z "
                                + "M 7 5.5 L 11.2 5.5 M 7 8 L 11.2 8 M 7 10.5 L 11.2 10.5 "
                                + "M 4.8 5.5 L 4.9 5.5 M 4.8 8 L 4.9 8 M 4.8 10.5 L 4.9 10.5",
                            fill-a: "",
                            fill-b: "",
                        },
                        {
                            tab: SettingsTab.advanced,
                            label: "System",
                            // a monitor on a stand
                            icon: "M 4 2.5 L 12 2.5 A 2 2 0 0 1 14 4.5 L 14 8.5 A 2 2 0 0 1 12 10.5 "
                                + "L 4 10.5 A 2 2 0 0 1 2 8.5 L 2 4.5 A 2 2 0 0 1 4 2.5 Z "
                                + "M 8 10.5 L 8 13.5 M 5 13.5 L 11 13.5",
                            fill-a: "",
                            fill-b: "",
                        },
                    ]: Rectangle {
                        height: 32px;
                        border-radius: 8.5px;
                        // the blue is fixed, so the text on it is a fixed white too - Palette.accent-foreground
                        // is dark in the dark theme
                        background: root.current-tab == t.tab ? #316def : transparent;
                        Path {
                            x: 10px;
                            width: 18px;
                            height: 18px;
                            viewbox-width: 16;
                            viewbox-height: 16;
                            commands: t.icon;
                            stroke: root.current-tab == t.tab ? #ffffff : Palette.accent-background;
                            stroke-width: 1.4px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                        }

                        // filled parts of an icon (only Appearance has them)
                        Path {
                            x: 10px;
                            width: 18px;
                            height: 18px;
                            viewbox-width: 16;
                            viewbox-height: 16;
                            commands: t.fill-a;
                            fill: root.current-tab == t.tab ? #ffffff : Palette.accent-background;
                            fill-rule: FillRule.evenodd;
                        }

                        Path {
                            x: 10px;
                            width: 18px;
                            height: 18px;
                            viewbox-width: 16;
                            viewbox-height: 16;
                            commands: t.fill-b;
                            fill: root.current-tab == t.tab ? #ffffff : Palette.accent-background;
                        }

                        Text {
                            text: t.label;
                            font-size: 13px;
                            x: 36px;
                            font-weight: root.current-tab == t.tab ? 700 : 400;
                            color: root.current-tab == t.tab ? #ffffff : Palette.foreground;
                            vertical-alignment: center;
                        }

                        tab-ta := TouchArea {
                            clicked => { root.current-tab = t.tab; }
                        }
                    }
                }
            }

            VerticalLayout {

                if root.current-tab == SettingsTab.general: GeneralTab {
                    quit-on-lost-focus: root.quit-on-lost-focus;
                    show-quit-on-lost-focus: root.show-quit-on-lost-focus;
                    unwrap-urls: root.unwrap-urls;
                    restorable-app-profiles: root.restorable-app-profiles;
                    quit-on-lost-focus-changed(v) => { root.quit-on-lost-focus-changed(v); }
                    unwrap-urls-changed(v) => { root.unwrap-urls-changed(v); }
                    restore-profile(id) => { root.restore-profile(id); }
                }
                if root.current-tab == SettingsTab.appearance: AppearanceTab {
                    theme: root.theme;
                    show-hotkeys: root.show-hotkeys;
                    text-size: root.text-size;
                    max-visible-browsers: root.max-visible-browsers;
                    min-visible-browsers: root.min-visible-browsers;
                    max-visible-browsers-limit: root.max-visible-browsers-limit;
                    theme-changed(t) => { root.theme-changed(t); }
                    text-size-changed(v) => { root.text-size-changed(v); }
                    max-visible-browsers-changed(v) => { root.max-visible-browsers-changed(v); }
                    show-hotkeys-changed(v) => { root.show-hotkeys-changed(v); }
                }
                if root.current-tab == SettingsTab.rules: RulesTab {
                    test-url-text <=> root.test-url-text;
                    test-url-result: root.test-url-result;
                    test-url-match-index: root.test-url-match-index;
                    test-url-edited => { root.test-url-edited(); }
                    rules: root.rules;
                    default-rule: root.default-rule;
                    browsers: root.browsers;
                    profile-picker-options: root.profile-picker-options;
                    default-browsers: root.default-browsers;
                    default-profile-picker-options: root.default-profile-picker-options;
                    add-rule => { root.add-rule(); }
                    remove-rule(i) => { root.remove-rule(i); }
                    url-changed(i, t) => { root.rule-url-changed(i, t); }
                    profile-changed(i, id) => { root.rule-profile-changed(i, id); }
                    incognito-changed(i, v) => { root.rule-incognito-changed(i, v); }
                }
                if root.current-tab == SettingsTab.advanced: AdvancedTab {
                    directories: root.directories;
                    is-default-browser: root.is-default-browser;
                    set-default => { root.set-default-browser(); }
                    refresh => { root.refresh(); }
                }
            }
        }
    }
}
