import { AboutSlint } from "std-widgets.slint";
import { AppPalette } from "theme.slint";
import { DirEntry, DirectoriesList } from "common.slint";

export component AboutWindow inherits Window {
    title: " ";
    // same level as the main popup, otherwise this renders behind it - NSWindowLevel stacking is
    // absolute, not affected by which window is active
    always-on-top: true;
    width: 340px;
    height: 345px;

    in property <image> app-icon;
    in property <string> version-text;
    in property <[DirEntry]> directories;

    Rectangle {
        background: AppPalette.about-background-color;

        VerticalLayout {
            padding: 10px;
            spacing: 10px;
            alignment: start;
            // centers the icon/title/version/copyright block - without this, fixed-size children
            // like the icon default to the left instead of centering
            cross-axis-alignment: center;

            Image {
                source: root.app-icon;
                width: 64px;
                height: 64px;
            }

            // StyledText with selectable instead of plain Text - Text has no built-in selection
            // (drag/double-click to select, Cmd/Ctrl+C to copy)
            StyledText {
                text: @markdown("**Browsers**");
                default-font-size: 14px;
                default-color: AppPalette.text-color;
                horizontal-alignment: center;
                selectable: true;
            }

            StyledText {
                text: @markdown("\{root.version-text}");
                default-font-size: 11px;
                default-color: AppPalette.text-color;
                horizontal-alignment: center;
                selectable: true;
            }

            StyledText {
                text: @markdown("© 2022-2026 Browsers.software team.");
                default-font-size: 11px;
                default-color: AppPalette.text-color;
                horizontal-alignment: center;
                selectable: true;
            }

            StyledText {
                text: @markdown("Visit us at [https://browsers.software](https://browsers.software).");
                default-font-size: 11px;
                default-color: AppPalette.text-color;
                link-color: AppPalette.accent-color;
                link-clicked(link) => { Platform.open-url(link); }
            }

            DirectoriesList {
                directories: root.directories;
                entry-font-size: 9px;
                entry-color: AppPalette.text-color;
            }

            // Required attribution for Slint's Royalty-free license -
            // see https://slint.dev/legal/licensing. Do not remove.
            AboutSlint { }
        }
    }
}
