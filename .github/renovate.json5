{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  packageRules: [
    {
      // must match the major/minor version Slint uses
      matchPackageNames: [
        'fontique'
      ],
      // 0.12.x
      allowedVersions: '~0.12',
    },
    {
      // must match the major/minor version winit (via Slint) uses, so Cargo resolves to one copy
      matchPackageNames: [
        'x11rb'
      ],
      // 0.13.x
      allowedVersions: '~0.13',
    },
    {
      // must match the major/minor version Slint uses, so Cargo resolves to one copy
      matchPackageNames: [
        'resvg'
      ],
      // 0.49.x
      allowedVersions: '~0.49',
    },
  ],
}
